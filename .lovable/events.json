{
  "schema_version": 1,
  "events": {
    "project.find_the_lady_email_captured": {
      "event_schema_version": 1,
      "description": "A visitor claimed the Find the Lady booking credit and received a code.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "found_queen",
          "opt_in"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "wedding",
              "corporate",
              "private_party",
              "other"
            ]
          },
          "found_queen": {
            "type": "boolean"
          },
          "opt_in": {
            "type": "boolean"
          }
        }
      }
    },
    "project.find_the_lady_play": {
      "event_schema_version": 1,
      "description": "A visitor started a round of Find the Lady (pressed Shuffle the cards or Play again).",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.find_the_lady_reveal": {
      "event_schema_version": 1,
      "description": "A visitor chose a card in Find the Lady and the three cards were revealed.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "found_queen"
        ],
        "properties": {
          "found_queen": {
            "type": "boolean"
          }
        }
      }
    },
    "project.find_the_lady_view": {
      "event_schema_version": 1,
      "description": "The Find the Lady pop-up opened, either when the visitor moved to leave the page or scrolled halfway down.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger"
        ],
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              "exit",
              "scroll"
            ]
          }
        }
      }
    },
    "project.find_the_queen_claim": {
      "event_schema_version": 1,
      "description": "A visitor submitted the Find the Queen email form and received a LIGHTS-UP code.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.find_the_queen_play": {
      "event_schema_version": 1,
      "description": "A visitor pressed Try your luck and the five card game started.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.find_the_queen_view": {
      "event_schema_version": 1,
      "description": "The Find the Queen pop-up opened: on exit intent, at half scroll, after 40 seconds on phones, or from the corner tab.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger"
        ],
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              "exit",
              "scroll",
              "timer",
              "tab"
            ]
          }
        }
      }
    },
    "project.find_the_queen_pick": {
      "event_schema_version": 1,
      "description": "A visitor picked a card in the Find the Queen game.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "found": {
            "type": "boolean"
          }
        },
        "required": [
          "found"
        ]
      }
    },
    "project.find_the_queen_answer": {
      "event_schema_version": 1,
      "description": "A visitor answered a Find the Queen question.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "enum": [
              "occasion",
              "timing"
            ]
          }
        },
        "required": [
          "question"
        ]
      }
    },
    "project.find_the_queen_reserve": {
      "event_schema_version": 1,
      "description": "A visitor pressed Reserve my date after receiving their Find the Queen code.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  }
}
